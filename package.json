{
  "name": "@singh-gur/pi-usage",
  "version": "1.5.0",
  "description": "Pi extension: /usage command and indicator for provider subscription quota and OpenRouter key allowance.",
  "author": "singh-gur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singh-gur/pi-usage.git"
  },
  "homepage": "https://github.com/singh-gur/pi-usage#readme",
  "bugs": {
    "url": "https://github.com/singh-gur/pi-usage/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.16.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "usage",
    "quota",
    "codex",
    "opencode",
    "kimi",
    "zai",
    "grok",
    "github-copilot",
    "openrouter"
  ],
  "files": [
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/singh-gur/pi-usage/main/assets/screenshots/dashboard.png"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0"
  }
}
