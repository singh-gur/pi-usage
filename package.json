{
  "name": "pi-usage",
  "version": "1.0.0",
  "private": true,
  "description": "Pi extension: /usage command and indicator for provider subscription quota and OpenRouter key allowance.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.16.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
